# Environment variables for TOPFORM LINE Bot
# Copy this to .env and fill in the values

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
ADMIN_USER_ID=

# Google Calendar API (JSON or base64 encoded)
GOOGLE_CREDENTIALS_JSON=

# 石原早見表 URL (existing Vercel deployment)
HAYAMIHYO_URL=https://ishihara-booking.vercel.app

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_PATH=./topform_line.db

# Local SQLite only. Cloud Run requires PostgreSQL.
DATABASE_URL=
DATABASE_PATH=./topform_line.db
# Random 32+ character secret; store in Secret Manager in production.
ADMIN_API_TOKEN=
# Exact customer master tab name (required in Cloud Run)
CUSTOMER_SHEET_NAME=

# Production: use the free-tier Firestore default database (no always-on SQL).
DATABASE_BACKEND=firestore
FIRESTORE_PROJECT=topform-booking-bot
FIRESTORE_PREFIX=topform
